# USB attached, no STA: the self-adb question, 2026-11-27.
# Curated transcript. USB debugging is enabled and the cable is attached.

# 1. The platform still refuses to enable Wireless debugging.
$ dumpsys usb
  connected=true
  configured=true
  host_connected=false
  kernel_state=CONFIGURED
  is_simulation_active=false

$ settings put global adb_wifi_enabled 1
$ settings get global adb_wifi_enabled
0
$ logcat -s AdbDebuggingManager
11-27 19:37:04.019  AdbDebuggingManager: Not connected to any wireless network. Not enabling adbwifi.

# 5555 stays up only because it was already pinned; USB plays no part.
$ getprop service.adb.tcp.port
5555
$ ss -ltn | grep 5555
LISTEN *:5555

# 2. Termux sees no phone over USB.
$ adb kill-server; adb devices
