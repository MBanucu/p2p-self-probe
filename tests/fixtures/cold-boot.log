# Cold boot after a successful pin, USB attached, 2026-11-27.
# Curated transcript from the reboot at 19:21:13 and the recovery at 19:27.

# Before the reboot.
$ uptime
 19:21:13 up 19:41
$ getprop service.adb.tcp.port
5555
$ settings get global adb_wifi_enabled
0
$ ip -4 -o addr show ap0
49: ap0    inet 10.31.180.89/24 brd 10.31.180.255 scope global ap0

# Reboot; USB adb comes back and the boot completes.
$ adb reboot
boot_completed after ~19s

# After the reboot: everything volatile is gone.
$ uptime
 19:22:12 up 0 min
$ getprop service.adb.tcp.port
(empty)
$ getprop persist.adb.tcp.port
(empty)
$ settings get global adb_wifi_enabled
0
$ ip -4 -o addr show
1: lo    inet 127.0.0.1/8
15: ccmni1 inet 10.184.117.106/8
# no ap0, no rndis0, no 5555 listener, hotspot off
$ ss -ltn | grep 5555
(no output)

# Processes after boot: Keeper is running, Termux is not.
$ pidof io.github.mbanucu.wirelessadbkeeper
2686
$ pidof com.termux
(empty)

# Recovery: bring the temporary AP back. The phone auto-joins and Keeper pins
# 5555 again with no host adb command.
$ nmcli connection up phonelink
Connection successfully activated
$ cmd wifi status
Wifi is connected to "PhoneLink"
11-27 19:28:49.147  WifiDebug  info pin.state listening on 5555
